{
  "name": "@aedge-io/grugway",
  "version": "0.1.0",
  "license": "MIT",
  "exports": "./lib/mod.ts",
  "publish": {
    "include": ["LICENSE.md", "README.md", "lib/**/*.ts"],
    "exclude": [
      "bench/",
      "cov/",
      "docs/",
      "examples/",
      "npm/",
      "scripts/",
      "lib/**/*_test.ts"
    ]
  },
  "fmt": {
    "exclude": ["cov/", "npm/"]
  },
  "tasks": {
    "build:npm": "deno run -A ./scripts/build_npm.ts",
    "build:cov": "deno coverage --lcov --output=./cov.lcov ./cov/",
    "check:ci": "deno check --doc",
    "hooks:install": "./scripts/install_hooks.ts",
    "test:ci": "deno test --parallel --fail-fast --coverage=./cov"
  },
  "imports": {
    "@david/dax": "jsr:@david/dax@0.45.0", //dev
    "@deno/dnt": "jsr:@deno/dnt@0.42.3", //dev
    "@std/assert": "jsr:@std/assert@1.0.18", //dev
    "@std/jsonc": "jsr:@std/jsonc@^1.0.2", //dev
    "@std/semver": "jsr:@std/semver@1.0.8", //dev
    "@std/testing": "jsr:@std/testing@1.0.17", //dev
    "@aedge-io/grugway": "./lib/mod.ts", //dev
    "grugway/examples": "./examples/doc_helpers.ts", //dev
    "grugway/pipeline": "./scripts/helpers/pipeline.ts", //dev
    "grugway/version": "./scripts/helpers/version.ts" //dev
  }
}
